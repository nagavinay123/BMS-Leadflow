# ==========================================================
# BMS LeadFlow — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to Git.
# NEVER paste these values into Lovable or any AI chat prompt.
# ==========================================================

# ── Supabase ───────────────────────────────────────────────
# Find at: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=eyJh...   # Use SERVICE ROLE key — NOT the anon key

# ── Google Maps / Places API ───────────────────────────────
# Enable "Places API" at: https://console.cloud.google.com/apis
GOOGLE_MAPS_API_KEY=AIza...

# ── Apify (alternative discovery source) ──────────────────
# Get at: https://console.apify.com/account#/integrations
APIFY_API_TOKEN=apify_api_...

# ── Companies House ────────────────────────────────────────
# Get at: https://developer-specs.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=your_ch_key_here

# ── Hunter.io (email finder) ───────────────────────────────
# Get at: https://hunter.io/api-keys
HUNTER_API_KEY=your_hunter_key_here

# ── MillionVerifier (email verification — REQUIRED for production) ──
# Get at: https://app.millionverifier.com
# This is REQUIRED. Without it, emails will be marked 'unverified'
# and will not enter the outreach queue.
MILLION_VERIFIER_API_KEY=your_mv_key_here

# ── Google PageSpeed Insights (optional but recommended) ───
# Enable "PageSpeed Insights API" at: https://console.cloud.google.com/apis
# Without this key, a response-time proxy is used instead.
GOOGLE_PAGESPEED_KEY=AIza...

# ── Anthropic (Claude AI personalisation) ─────────────────
# Get at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Email Platform (Smartlead) ─────────────────────────────
# Get at: https://app.smartlead.ai → Settings → API Keys
SMARTLEAD_API_KEY=sl-...
EMAIL_PROVIDER=smartlead

# ── Compliance / footer ────────────────────────────────────
BMS_COMPANY_NUMBER=12345678
BMS_REGISTERED_ADDRESS=123 Example Street, London, EC1A 1BB
UNSUBSCRIBE_URL=https://bemysocial.co.uk/unsubscribe

# ── Sending domain (required for DNS checks) ──────────────
# The domain you will send FROM (e.g. bemysocial.co.uk)
# Used to verify SPF, DKIM, DMARC via GET /api/production-readiness
SENDING_DOMAIN=yourdomain.co.uk

# The DKIM selector used by your ESP (ask Smartlead — usually "s1" or "google")
DKIM_SELECTOR=s1

# ── Production readiness flags ─────────────────────────────
# These MUST be set manually after completing the real-world steps.
# Claude cannot set these automatically. A human operator must confirm each.

# Set to true ONLY after 6–8 weeks of inbox warmup at 20+ emails/day
EMAIL_WARMUP_COMPLETED=false

# Set to true ONLY after your legal adviser has signed off the LIA document
LIA_APPROVED=false

# Set to true ONLY after the privacy notice is live at bemysocial.co.uk/privacy
PRIVACY_NOTICE_CONFIRMED=false

# ── Safety ────────────────────────────────────────────────
# DRY_RUN=true means NO REAL EMAILS ARE SENT.
# Set to false ONLY after ALL of the following are confirmed:
#   - EMAIL_WARMUP_COMPLETED=true
#   - LIA_APPROVED=true
#   - PRIVACY_NOTICE_CONFIRMED=true
#   - SPF/DKIM/DMARC verified (GET /api/production-readiness shows all READY)
#   - Seed inbox test passed
#   - ready_for_live_sending=true from /api/production-readiness
DRY_RUN=true

# ── Calendly integration ─────────────────────────────────────────────────────
# Public booking URL — included in every outreach email
# Get it from: calendly.com → your event type → Share → Copy link
CALENDLY_BOOKING_URL=https://calendly.com/james-bemysocial/30min

# Webhook: set this endpoint in Calendly → Integrations → Webhooks
# URL: https://bms-leadflow-production.up.railway.app/api/webhooks/calendly
# Events to subscribe: invitee.created, invitee.canceled

# ── Score threshold ──────────────────────────────────────────────────────────
OUTREACH_SCORE_THRESHOLD=50
